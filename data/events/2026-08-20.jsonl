{"id": "samsung_elec-2026-08-20-018", "date": "2026-08-20", "time_tags": {"year": 2026, "quarter": "Q3", "month": 8, "week": 34, "weekday": "Thu"}, "entities": {"companies": ["samsung_elec"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Samsung to break ground on KRW6 trillion Onyang HBM packaging plant in September", "content": "Samsung Electronics will break ground in September on a KRW6 trillion (approx. US$4.31 billion) HBM production and advanced-packaging facility at its Onyang campus in Asan, South Korea, after the project cleared a provincial urban-planning review. The move advances a broader capacity buildout to meet growing AI memory demand.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260820VL203/samsung-hbm-packaging-plant-production.html", "type": "rss"}]}
{"id": "lg_elec-2026-08-20-019", "date": "2026-08-20", "time_tags": {"year": 2026, "quarter": "Q3", "month": 8, "week": 34, "weekday": "Thu"}, "entities": {"companies": ["lg_elec"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "LG acquires Mexico TV parts plant to cut production costs", "content": "LG Electronics has acquired a local TV parts factory in Mexico. The move strengthens cost competitiveness and tightens control over its supply chain at one of its key North American production bases. It also gives the company an existing manufacturing facility and inventory already suited to its TV operations, bringing production of selected components closer to final assembly.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260820PD208/production-tv-lg-lg-electronics-mexico.html", "type": "rss"}]}
