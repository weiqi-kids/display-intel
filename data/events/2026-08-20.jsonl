{"id": "unknown-2026-08-20-016", "date": "2026-08-20", "time_tags": {"year": 2026, "quarter": "Q3", "month": 8, "week": 34, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "positive", "score": 1.0, "keywords": ["record"]}, "importance": {"score": 0.9, "reasons": ["涉及財報", "情緒極端"]}, "title": "Nvidia, TSMC, chip gear makers ride AI boom into high-margin club", "content": "Strong AI demand is driving a wave of high profitability across the semiconductor supply chain, with equipment and materials suppliers increasingly joining a \"high-margin club.\" Trailing only Nvidia's 75% gross margin in the fiscal first quarter of 2027 (which ended in April 2026), TSMC posted a record quarterly gross margin of 67.72% in the second quarter, with its first-half margin also reaching 67%. Related suppliers have joined the club as well.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260820PD209/gross-margin-nvidia-tsmc-demand-profit.html", "type": "rss"}]}
