{"id": "unknown-2026-10-11-014", "date": "2026-10-11", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 41, "weekday": "Sun"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["growth"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Everlight Chemical September revenue rises on strong electronic chemicals demand", "content": "Everlight Chemical reported higher September and year-to-date revenue, with electronic chemicals driving most of the growth. The results suggest continued resilience in industrial and specialty materials demand, a trend relevant to global manufacturers, supply chains, and investors watching Asian chemical producers amid uneven market conditions.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261008PD215/revenue-everlight-demand-2026-growth.html", "type": "rss"}]}
