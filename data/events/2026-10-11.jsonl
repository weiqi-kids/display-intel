{"id": "novatek-2026-10-11-011", "date": "2026-10-11", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 41, "weekday": "Sun"}, "entities": {"companies": ["novatek"], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["growth"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Novatek quarterly revenue tops NT$30B as smartphone demand, edge AI chips lift results", "content": "Novatek reported stronger September and third-quarter 2026 revenue, suggesting seasonal smartphone demand and growth in edge AI chips are supporting the global display and chip supply chain. The results matter for international readers because they reflect broader shifts in consumer electronics demand, inventory patterns, and AI-related hardware spending.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261008PD239/novatek-revenue-chips-smartphone-demand-2026.html", "type": "rss"}]}
{"id": "unknown-2026-10-11-012", "date": "2026-10-11", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 41, "weekday": "Sun"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Changs Ascending September revenue jumps 92% on semiconductor plant buildouts", "content": "Changs Ascending said orders tied to semiconductor customers' new plant construction, equipment arrivals, and project acceptance schedules were gradually fulfilled and recognized as revenue, lifting consolidated revenue to NT$79.2 million (approx. US$2.49 million) in September 2026, up 92% from a month earlier and 14% from a year earlier.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261008PD229/revenue-plant-equipment-ups-aidc.html", "type": "rss"}]}
