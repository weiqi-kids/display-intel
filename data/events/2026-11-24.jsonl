{"id": "samsung_elec-2026-11-24-007", "date": "2026-11-24", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 48, "weekday": "Tue"}, "entities": {"companies": ["samsung_elec"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Samsung memory capacity through 2029 largely under contract, Korean report says", "content": "AI data center demand is pushing memory supply negotiations years into the future. Most of Samsung Electronics' memory chip production capacity for 2027 through 2029 is already secured under contract, South Korean outlet <em>Economy Tribune</em> reported on November 21, citing a person familiar with the matter. Samsung has not publicly confirmed the report.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261124VL220/samsung-capacity-demand-data-center-2027.html", "type": "rss"}]}
