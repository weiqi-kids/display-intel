{"id": "canon-2026-11-25-013", "date": "2026-11-25", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 48, "weekday": "Wed"}, "entities": {"companies": ["canon"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Canon unveils first new ArF dry scanner in 24 years", "content": "Canon will begin taking orders in early December for its first new argon fluoride (ArF) dry lithography scanner in 24 years, returning to a market it exited in 2007 as demand for semiconductor manufacturing equipment grows.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261125VL218/canon-arf-scanner-equipment-manufacturing.html", "type": "rss"}]}
{"id": "unknown-2026-11-25-014", "date": "2026-11-25", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 48, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["mini_led"], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["weak"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Congo halts cobalt exports, but CATL may see limited impact for now", "content": "The Democratic Republic of the Congo (DRC) has announced a suspension of cobalt exports to stabilize prices amid weak global demand. The development may have a limited impact on electric battery makers like CATL due to the emergence of low-cobalt technologies and alternative sources of the metal, although the DRC's market dominance still makes it difficult for cobalt buyers to replace.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261125VL223/cobalt-catl-exports-congo-market.html", "type": "rss"}]}
{"id": "unknown-2026-11-25-015", "date": "2026-11-25", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 48, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "positive", "score": 1.0, "keywords": ["record"]}, "importance": {"score": 0.9, "reasons": ["涉及財報", "情緒極端"]}, "title": "Memory surge weighs on Japan's mobile market outlook through 2027", "content": "Tight memory supply and broader inflation are squeezing Japan's mobile phone market. According to Japanese market research firm MM Research Institute, total handset shipments in Japan fell 9.2% year-over-year to 12.889 million units in the first half of fiscal 2026 (April&ndash;September 2026). This was the second-lowest first-half volume recorded since fiscal 2000, trailing only the first half of fiscal 2023.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261125PD215/market-shipments-mobile-2027-inflation.html", "type": "rss"}]}
