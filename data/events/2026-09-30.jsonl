{"id": "unknown-2026-09-30-009", "date": "2026-09-30", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 40, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": ["growth", "[否定]expand"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Leisure vehicles become Eurocharm's largest segment with capacity expanding in Vietnam, North America", "content": "Taiwan's Eurocharm Holdings, an OEM automotive and motorcycle parts maker, said at an earnings call on September 29 that leisure vehicles had become its largest product segment, as it expands production capacity in Vietnam and North America to meet rising customer demand. The company reported strong year-over-year growth in revenue and profit for the first half of 2026.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260930PD224/taiwan-revenue-north-america-capacity-oem.html", "type": "rss"}]}
{"id": "unknown-2026-09-30-010", "date": "2026-09-30", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 40, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["mini_led"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": ["growth", "[否定]expand"]}, "importance": {"score": 0.5, "reasons": []}, "title": "EOI lays out three growth engines, eyes AI optical communications", "content": "Excellence Optoelectronics (EOI) is banking on stronger orders from its top five customers and new-car launches to drive a recovery in 2026, as the automotive optics and Mini LED module maker expands in Mexico, adds non-headlamp automotive electronics, and pushes into AI optical communications with a sample target in early 2027.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260930PD232/eoi-communications-growth-2026-plant.html", "type": "rss"}]}
{"id": "unknown-2026-09-30-011", "date": "2026-09-30", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 40, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["mini_led"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["growth"]}, "importance": {"score": 0.5, "reasons": []}, "title": "AI boom draws display makers into semiconductors with glass core substrates and Micro LED", "content": "AI is driving the semiconductor industry into a new growth cycle while creating opportunities for display companies traditionally centered on panels to move into semiconductors. These companies are extending their reach into emerging areas such as advanced packaging and optical communications, seeking to leverage core technologies such as glass substrates and Micro LED.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260930PD221/display-semiconductors-packaging-growth-technology.html", "type": "rss"}]}
