{"id": "unknown-2026-06-25-006", "date": "2026-06-25", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 26, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "positive", "score": 0.25, "keywords": ["record", "[否定]mass production"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "IntelliEPI targets record 2026 revenue amid InP substrate shortages", "content": "Compound semiconductor epitaxial wafer maker IntelliEPI said AI-driven high-speed transmission demand continues to lift the indium phosphide (InP) market, and it expects revenue to keep rising in 2026 and set another record. The company's biggest challenge remains a shortage of InP substrates, prompting it to rely mainly on Japanese suppliers while helping German manufacturers accelerate mass production of InP substrates.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260624PD240/inp-intelliepi-2026-substrate-wafer.html", "type": "rss"}]}
