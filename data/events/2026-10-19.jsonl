{"id": "samsung_elec-2026-10-19-004", "date": "2026-10-19", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 43, "weekday": "Mon"}, "entities": {"companies": ["samsung_elec"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": ["improve", "pressure"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Samsung targets Exynos 2700 expansion as Huawei advances Kirin chips", "content": "Samsung Electronics is developing the Exynos 2700 for broader use across its Galaxy S27 lineup in 2027, while Huawei has moved its next-generation Kirin chips into testing. The competing efforts are raising pressure on Samsung to improve application processor (AP) performance, manufacturing yields and cost competitiveness as it seeks to reduce its reliance on Qualcomm and MediaTek.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261019PD247/samsung-exynos-kirin-huawei-chips.html", "type": "rss"}]}
{"id": "samsung_elec-2026-10-19-005", "date": "2026-10-19", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 43, "weekday": "Mon"}, "entities": {"companies": ["samsung_elec"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["[否定]expand"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Elon Musk points to China's 2028 DRAM supply surge to challenge Samsung, SK Hynix pricing power", "content": "Tesla CEO Elon Musk has predicted a surge in Chinese memory chip production by 2028, raising questions over Samsung Electronics and SK Hynix's pricing power during an AI-driven dynamic random-access memory (DRAM) shortage. His remarks suggest that China's expanding capacity could offer major technology buyers alternative sources of supply and potentially ease memory costs.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261019VL210/elon-musk-dram-tesla-2028-samsung.html", "type": "rss"}]}
{"id": "canon-2026-10-19-006", "date": "2026-10-19", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 43, "weekday": "Mon"}, "entities": {"companies": ["canon"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Canon Taiwan sees strong global camera demand in 2026 and 2027", "content": "Canon Marketing Taiwan President Hu Da-gang said the global camera market performed well in 2026, with demand rebounding after the pandemic and smartphone photography helping cultivate a new generation of photography enthusiasts. He also expressed optimism about 2027, as Canon and other brands prepare to launch more new models and capitalize on market momentum.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261019PD240/canon-taiwan-camera-demand-2027.html", "type": "rss"}]}
