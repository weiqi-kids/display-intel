{"id": "novatek-2026-07-08-006", "date": "2026-07-08", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Wed"}, "entities": {"companies": ["novatek"], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Novatek beats second-quarter revenue guidance on strong customer stockpiling", "content": "Novatek reported June revenue of NT$10.023 billion, up 6.48% from the previous month and 18.96% from a year earlier, pushing second-quarter revenue to NT$28.66 billion. The chip designer's second-quarter result rose 24% quarter over quarter and 9.59% year over year, topping its earlier forecast of NT$27.5 billion to NT$28.5 billion.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260707PD242/revenue-novatek-display-forecast-performance.html", "type": "rss"}]}
{"id": "unknown-2026-07-08-007", "date": "2026-07-08", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["increase"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "ELAN revenue hit the top of forecast as notebook and AI products gained traction", "content": "ELAN reported June 2026 revenue of NT$1.059 billion, up 5.48% from the prior month and 7.13% from a year earlier. The Taiwanese chip maker said second-quarter 2026 revenue reached NT$3.368 billion, up 4.4% quarter-over-quarter and 11.1% year-over-year, while first-half revenue totaled NT$5.37 billion, a 4.04% increase from a year earlier.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20260707PD241/revenue-2026-forecast-production-business.html", "type": "rss"}]}
