{"id": "samsung_elec-2026-10-23-013", "date": "2026-10-23", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 43, "weekday": "Fri"}, "entities": {"companies": ["samsung_elec"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Semco's 61-week MLCC lead times give suppliers upper hand in AI supply chain", "content": "Samsung Electro-Mechanics (Semco) is gaining pricing power as AI server demand extends multilayer ceramic capacitor (MLCC) lead times beyond a year. Shortages now span consumer, automotive and industrial products, prompting customers to secure 2027 supplies.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261023VL202/semco-mlcc-ai-server-2027-demand.html", "type": "rss"}]}
{"id": "unknown-2026-10-23-014", "date": "2026-10-23", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 43, "weekday": "Fri"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Lenovo mounts AI comeback with Nvidia Vera Rubin NVL72 deliveries and US plant expansion", "content": "More than 30 years ago, Lenovo set out with a vision to bring personal computers into every household. Today, Chairman and CEO Yuanqing Yang has defined a new mission for the 42-year-old tech giant: bring artificial intelligence to every home and industry, while transforming Lenovo into an AI-native enterprise targeting over US$100 billion in annual revenue within two years.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261023PD225/lenovo-nvidia-infrastructure-rubin-manufacturing.html", "type": "rss"}]}
{"id": "samsung_elec-2026-10-23-015", "date": "2026-10-23", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 43, "weekday": "Fri"}, "entities": {"companies": ["samsung_elec"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Samsung reportedly orders final tools for first Taylor fab as Texas site nears 2nm output cap", "content": "Samsung Electronics has ordered additional equipment to fill the remaining space at its first foundry fab in Taylor, Texas, a move that would lift the plant's 2nm capacity to 20,000 wafers per month in the second half of 2027, <em>ZDNet Korea</em> reported on October 23, citing industry sources.", "sources": [{"name": "digitimes_display", "url": "https://www.digitimes.com/news/a20261023VL219/samsung-texas-2nm-fab.html", "type": "rss"}]}
